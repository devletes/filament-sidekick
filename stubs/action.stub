<?php

namespace {{ namespace }};

use Devletes\Sidekick\Support\SidekickAction;
use Illuminate\Contracts\Auth\Authenticatable;
use Illuminate\Contracts\JsonSchema\JsonSchema;
use InvalidArgumentException;

/** Offered to the model as Propose{{ class }}; execute() runs only on the user's Confirm click. */
class {{ class }} extends SidekickAction
{
    public function description(): string
    {
        return 'Describe what this action does.';
    }

    /** @return array<string, \Illuminate\JsonSchema\Types\Type> */
    public function schema(JsonSchema $schema): array
    {
        return [
            'name' => $schema->string()
                ->description('...')
                ->required(),
        ];
    }

    /** Throw InvalidArgumentException with a user-readable message; the model sees it and can correct itself. */
    public function prepare(array $payload, Authenticatable $user): array
    {
        $name = trim((string) ($payload['name'] ?? ''));

        if ($name === '') {
            throw new InvalidArgumentException('A name is required.');
        }

        return [
            'payload' => ['name' => $name],
            'summary' => "Create \"{$name}\"",
            'preview' => [
                ['label' => 'Name', 'value' => $name],
            ],
            // Ask for a file on the card; ids arrive in $payload['attachment_ids'] at execute time:
            // 'upload' => ['required' => false, 'label' => 'Attachment', 'multiple' => false],
        ];
    }

    /** Runs under the user's session on Confirm: re-validate against live data, return a short outcome line. */
    public function execute(array $payload, Authenticatable $user): string
    {
        // Thing::create(['name' => $payload['name'], ...]);

        return 'Done.';
    }

    // Confirm in a modal instead of inline, for previews too large for the dock:
    // public function confirmation(): \Devletes\Sidekick\Enums\ConfirmationMode
    // {
    //     return \Devletes\Sidekick\Enums\ConfirmationMode::Modal;
    // }

    // Withhold the action if these classes are deleted; `php artisan sidekick:check` reports it:
    // public function dependsOn(): array
    // {
    //     return [Thing::class];
    // }
}
