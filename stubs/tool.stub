<?php

namespace {{ namespace }};

use Devletes\Sidekick\Support\ChatToolBase;
use Illuminate\Contracts\JsonSchema\JsonSchema;
use Laravel\Ai\Tools\Request;

class {{ class }} extends ChatToolBase
{
    /** Tells the model what this tool does and when to call it. */
    public function description(): string
    {
        return 'Describe what this tool looks up.';
    }

    /**
     * The arguments the model must supply.
     *
     * @return array<string, \Illuminate\JsonSchema\Types\Type>
     */
    public function schema(JsonSchema $schema): array
    {
        return [
            'query' => $schema->string()
                ->description('What to look up.')
                ->required(),
        ];
    }

    /** Status line shown in the panel while the tool runs. */
    public function label(): string
    {
        return 'Looking that up';
    }

