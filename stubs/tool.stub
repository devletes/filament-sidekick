    /** Tells the model what this tool does and when to call it. */
    public function description(): string
    {
        return 'Describe what this tool looks up.';
    }

    /**
     * The arguments the model must supply.
     *
     * @return array<string, \Illuminate\JsonSchema\Types\Type>
     */
    public function schema(JsonSchema $schema): array
    {
        return [
            'query' => $schema->string()
                ->description('What to look up.')
                ->required(),
        ];
    }

