<?php

namespace {{ namespace }};

use {{ resource }};
use Devletes\Sidekick\Support\SidekickAction;
use Illuminate\Contracts\Auth\Authenticatable;
use Illuminate\Contracts\JsonSchema\JsonSchema;
use InvalidArgumentException;

/** execute() throws until you implement it, so an unfinished scaffold cannot write. */
class {{ class }} extends SidekickAction
{
    public function description(): string
    {
        return 'Create a new {{ singular }}.';
    }

    /** Offered only in this panel's assistant ('*' = every panel). */
    public function panels(): array
    {
        return [{{ panels }}];
    }

    /** Withheld if {{ resourceBasename }} is deleted; `php artisan sidekick:check` reports it. */
    public function dependsOn(): array
    {
        return [{{ resourceBasename }}::class];
    }

    /**
     * TODO: mirror the fields of {{ resourceBasename }}::form().
     *
     * @return array<string, \Illuminate\JsonSchema\Types\Type>
     */
    public function schema(JsonSchema $schema): array
    {
        return [
            '{{ titleAttribute }}' => $schema->string()->required(),
        ];
    }

    // TODO: every action is offered to the model, so lock down who may propose it before shipping:
    // public function authorize(Authenticatable $user): bool
    // {
    //     return $user->can('create', {{ resourceBasename }}::getModel());
    // }

    public function prepare(array $payload, Authenticatable $user): array
    {
        $value = trim((string) ($payload['{{ titleAttribute }}'] ?? ''));

        if ($value === '') {
            throw new InvalidArgumentException('A {{ titleAttribute }} is required.');
        }

        return [
            'payload' => ['{{ titleAttribute }}' => $value],
            'summary' => "Create {{ singular }} \"{$value}\"",
            'preview' => [
                ['label' => '{{ titleHuman }}', 'value' => $value],
            ],
        ];
    }

    public function execute(array $payload, Authenticatable $user): string
    {
        // TODO: create the record and return a short outcome line, e.g.:
        // {{ resourceBasename }}::getModel()::create($payload);
        // return 'Created.';

        throw new InvalidArgumentException('{{ class }} is scaffolded but execute() is not implemented yet.');
    }
}
