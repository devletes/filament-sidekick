<?php

namespace {{ namespace }};

use {{ resource }};
use Devletes\Sidekick\Support\ChatToolBase;
use Illuminate\Contracts\JsonSchema\JsonSchema;
use Laravel\Ai\Tools\Request;

/** Generated by sidekick:scaffold; re-runs never overwrite this file. */
class {{ class }} extends ChatToolBase
{
    public function description(): string
    {
        return 'Search {{ plural }} by keyword and return the closest matches.';
    }

    public function schema(JsonSchema $schema): array
    {
        return [
            'query' => $schema->string()
                ->description('Keyword to search for.')
                ->required(),
        ];
    }

    public function label(): string
    {
        return 'Searching {{ plural }}';
    }

    /** Offered only in this panel's assistant ('*' = every panel). */
    public function panels(): array
    {
        return [{{ panels }}];
    }

    /** Withheld if {{ resourceBasename }} is deleted; `php artisan sidekick:check` reports it. */
    public function dependsOn(): array
    {
        return [{{ resourceBasename }}::class];
    }

    // TODO: restrict who is offered this tool, e.g.:
    // public function authorize(\Illuminate\Contracts\Auth\Authenticatable $user): bool
    // {
    //     return $user->can('viewAny', {{ resourceBasename }}::getModel());
    // }

    public function handle(Request $request): string
    {
        $query = trim((string) $request['query']);

        // TODO: also scope to $this->user if this data is per-user, and trim the returned fields.
        $results = {{ resourceBasename }}::getEloquentQuery()
            ->where(function ($q) use ($query) {
                foreach ([{{ attributes }}] as $attribute) {
                    $q->orWhere($attribute, 'like', "%{$query}%");
                }
            })
            ->limit(8)
            ->get()
            ->map(fn ($record) => [
                'id' => (string) $record->getKey(),
                'title' => (string) $record->{{ title }},
            ]);

        return $this->respond(['query' => $query, 'results' => $results]);
    }
}
